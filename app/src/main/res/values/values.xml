<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">PSTV</string>

    <style name="Theme.Pstv" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text_dim</item>
        <item name="android:alertDialogTheme">@style/Theme.Pstv.Dialog</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:fontFamily">@string/font_regular</item>
    </style>

    <style name="Theme.Pstv.Dialog" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:colorBackground">@color/surface</item>
        <item name="android:windowBackground">@drawable/frost_panel</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text_dim</item>
    </style>

    <style name="Theme.Pstv.Info" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:fontFamily">@string/font_regular</item>
    </style>

    <style name="Btn">
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:background">@drawable/btn_bg</item>
        <item name="android:textColor">@color/btn_text</item>
        <item name="android:textSize">@dimen/type_body</item>
        <item name="android:fontFamily">@string/font_medium</item>
        <item name="android:gravity">center</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:paddingLeft">20dp</item>
        <item name="android:paddingRight">20dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:stateListAnimator">@animator/focus_pop</item>
    </style>

    <style name="BtnPrimary" parent="Btn">
        <item name="android:background">@drawable/btn_primary_bg</item>
        <item name="android:textColor">@color/on_accent</item>
        <item name="android:drawableTint">@color/on_accent</item>
    </style>

    <style name="Tab" parent="Btn">
        <item name="android:background">@drawable/tab_bg</item>
        <item name="android:textColor">@drawable/tab_text</item>
        <item name="android:fontFamily">@string/font_medium</item>
        <item name="android:textSize">@dimen/type_body</item>
        <item name="android:paddingLeft">13dp</item>
        <item name="android:paddingRight">13dp</item>
        <item name="android:paddingTop">5dp</item>
        <item name="android:paddingBottom">5dp</item>
    </style>

    <style name="Rail">
        <item name="android:layout_width">34dp</item>
        <item name="android:layout_height">34dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:padding">7dp</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:background">@drawable/rail_bg</item>
        <item name="android:tint">@drawable/tab_text</item>
        <item name="android:stateListAnimator">@animator/focus_pop</item>
    </style>

    <style name="Chip">
        <item name="android:background">@drawable/chip_bg</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">@dimen/type_micro</item>
        <item name="android:paddingLeft">8dp</item>
        <item name="android:paddingRight">8dp</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">3dp</item>
        <item name="android:layout_marginRight">6dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:visibility">gone</item>
    </style>
</resources>
