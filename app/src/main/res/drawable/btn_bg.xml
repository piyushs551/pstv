<?xml version="1.0" encoding="utf-8"?>
<!-- Secondary pill: translucent idle, bright when focused -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle"><solid android:color="@color/focus_ring" /><corners android:radius="@dimen/radius_pill" /></shape>
    </item>
    <item>
        <shape android:shape="rectangle"><solid android:color="@color/pill_idle" /><corners android:radius="@dimen/radius_pill" /></shape>
    </item>
</selector>
