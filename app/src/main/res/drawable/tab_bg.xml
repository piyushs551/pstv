<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle"><solid android:color="@color/focus_ring" /><corners android:radius="@dimen/radius_pill" /></shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="rectangle"><solid android:color="@color/pill_selected" /><corners android:radius="@dimen/radius_pill" /></shape>
    </item>
    <item>
        <shape android:shape="rectangle"><solid android:color="@android:color/transparent" /><corners android:radius="@dimen/radius_pill" /></shape>
    </item>
</selector>
