<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card"
    android:layout_width="104dp"
    android:layout_height="156dp"
    android:background="@color/surface2"
    android:focusable="true"
    android:foreground="@drawable/card_focus">

    <ImageView android:id="@+id/card_img" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" />

    <TextView
        android:id="@+id/card_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/scrim_label"
        android:ellipsize="end"
        android:maxLines="2"
        android:paddingBottom="6dp"
        android:paddingLeft="6dp"
        android:paddingRight="6dp"
        android:paddingTop="16dp"
        android:textColor="@color/text"
        android:textSize="11sp" />

    <View
        android:id="@+id/card_bar"
        android:layout_width="0dp"
        android:layout_height="3dp"
        android:layout_gravity="bottom"
        android:background="@color/accent"
        android:visibility="gone" />
</FrameLayout>
