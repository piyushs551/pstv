<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:focusable="true"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/card_frame"
        android:layout_width="@dimen/poster_w"
        android:layout_height="@dimen/poster_h"
        android:background="@drawable/card_bg"
        android:clipToOutline="true"
        android:duplicateParentState="true"
        android:elevation="2dp"
        android:foreground="@drawable/card_focus">

        <com.pstv.tv.CardImageView android:id="@+id/card_img" android:layout_width="match_parent" android:layout_height="match_parent" />

        <TextView
            android:id="@+id/card_rank"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|left"
            android:fontFamily="@string/font_strong"
            android:paddingLeft="8dp"
            android:shadowColor="#000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="6"
            android:textColor="@color/text"
            android:textSize="@dimen/type_display"
            android:visibility="gone" />

        <TextView
            android:id="@+id/card_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|left"
            android:layout_margin="8dp"
            android:background="@drawable/tag_bg"
            android:ellipsize="end"
            android:fontFamily="@string/font_medium"
            android:maxLines="1"
            android:paddingBottom="2dp"
            android:paddingLeft="7dp"
            android:paddingRight="7dp"
            android:paddingTop="2dp"
            android:textColor="@color/text"
            android:textSize="@dimen/type_micro"
            android:visibility="gone" />

        <View
            android:id="@+id/card_bar"
            android:layout_width="0dp"
            android:layout_height="3dp"
            android:layout_gravity="bottom"
            android:background="@color/text"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Title appears under the focused card only (space is reserved so rows never jump) -->
    <LinearLayout
        android:id="@+id/card_caption"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="@dimen/caption_h"
        android:alpha="0"
        android:orientation="vertical"
        android:paddingLeft="2dp"
        android:paddingTop="6dp">

        <TextView
            android:id="@+id/card_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@string/font_medium"
            android:maxLines="1"
            android:textColor="@color/text"
            android:textSize="@dimen/type_caption" />

        <TextView
            android:id="@+id/card_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_dim"
            android:textSize="@dimen/type_micro" />
    </LinearLayout>
</LinearLayout>
