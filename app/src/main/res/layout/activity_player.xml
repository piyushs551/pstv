<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:resize_mode="fit"
        app:show_buffering="never"
        app:surface_type="surface_view"
        app:use_controller="false" />

    <ProgressBar
        android:id="@+id/spin"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="center"
        android:visibility="gone" />

    <!-- Seek / info overlay -->
    <LinearLayout
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/scrim_label"
        android:orientation="vertical"
        android:paddingBottom="24dp"
        android:paddingLeft="48dp"
        android:paddingRight="48dp"
        android:paddingTop="40dp"
        android:visibility="gone">

        <TextView android:id="@+id/p_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textColor="@color/text" android:textSize="18sp" android:textStyle="bold" />
        <ProgressBar
            android:id="@+id/p_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginBottom="4dp"
            android:layout_marginTop="8dp"
            android:max="1000"
            android:progressTint="@color/accent" />
        <TextView android:id="@+id/p_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text_dim" android:textSize="13sp" />
        <TextView android:id="@+id/p_hint" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="@color/text_dim" android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/p_banner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|left"
        android:layout_margin="32dp"
        android:background="#B0000000"
        android:padding="12dp"
        android:textColor="@color/text"
        android:textSize="20sp"
        android:visibility="gone" />

    <!-- Mini channel list (live) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/chan_list"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:background="#E60B0B10"
        android:padding="8dp"
        android:visibility="gone" />
</FrameLayout>
