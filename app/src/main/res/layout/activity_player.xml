<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:resize_mode="fit"
        app:show_buffering="never"
        app:surface_type="surface_view"
        app:use_controller="false" />

    <ProgressBar android:id="@+id/spin" android:layout_width="44dp" android:layout_height="44dp" android:layout_gravity="center" android:visibility="gone" />

    <LinearLayout
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/scrim_label"
        android:orientation="vertical"
        android:paddingBottom="@dimen/safe_v"
        android:paddingLeft="@dimen/safe_h"
        android:paddingRight="@dimen/safe_h"
        android:paddingTop="56dp"
        android:visibility="gone">

        <LinearLayout android:id="@+id/p_chips" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" />
        <TextView android:id="@+id/p_sub" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:maxLines="1" android:textColor="@color/text" android:textSize="@dimen/type_caption" />
        <TextView android:id="@+id/p_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textColor="@color/text" android:textSize="@dimen/type_headline" android:fontFamily="@string/font_strong" />

        <com.pstv.tv.SeekLine
            android:id="@+id/p_bar_wrap"
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:layout_marginTop="8dp"
            android:focusable="true" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/p_time" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="@color/text" android:textSize="@dimen/type_caption" />
            <TextView android:id="@+id/p_prev" style="@style/Btn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="8dp" android:paddingBottom="5dp" android:paddingTop="5dp" android:textSize="@dimen/type_caption" android:drawableLeft="@drawable/ic_prev" android:text="Previous" android:visibility="gone" />
            <TextView android:id="@+id/p_play" style="@style/BtnPrimary" android:drawableLeft="@drawable/ic_pause" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="8dp" android:paddingBottom="5dp" android:paddingTop="5dp" android:text="Pause" android:textSize="@dimen/type_caption" />
            <TextView android:id="@+id/p_next" style="@style/Btn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="8dp" android:paddingBottom="5dp" android:paddingTop="5dp" android:textSize="@dimen/type_caption" android:drawableLeft="@drawable/ic_next" android:text="Next" android:visibility="gone" />
            <TextView android:id="@+id/p_audio" style="@style/Btn" android:drawableLeft="@drawable/ic_audio" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="8dp" android:paddingBottom="5dp" android:paddingTop="5dp" android:text="Audio" android:textSize="@dimen/type_caption" />
            <TextView android:id="@+id/p_subs" style="@style/Btn" android:drawableLeft="@drawable/ic_cc" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="8dp" android:paddingBottom="5dp" android:paddingTop="5dp" android:text="Subtitles" android:textSize="@dimen/type_caption" />
            <TextView android:id="@+id/p_aspect" style="@style/Btn" android:drawableLeft="@drawable/ic_aspect" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="8dp" android:paddingBottom="5dp" android:paddingTop="5dp" android:text="Aspect" android:textSize="@dimen/type_caption" />
        </LinearLayout>
        <TextView android:id="@+id/p_hint" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/text_dim" android:textSize="@dimen/type_micro" />
    </LinearLayout>

    <TextView
        android:id="@+id/p_banner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|left"
        android:layout_marginLeft="@dimen/safe_h"
        android:layout_marginTop="@dimen/safe_v"
        android:background="@drawable/frost_panel"
        android:paddingBottom="8dp"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="8dp"
        android:textColor="@color/text"
        android:textSize="@dimen/type_headline"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/cat_list"
        android:layout_width="230dp"
        android:layout_height="match_parent"
        android:layout_marginBottom="@dimen/safe_v"
        android:layout_marginLeft="@dimen/safe_h"
        android:layout_marginTop="@dimen/safe_v"
        android:background="@drawable/frost_panel"
        android:padding="8dp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/chan_list"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_marginBottom="@dimen/safe_v"
        android:layout_marginLeft="@dimen/safe_h"
        android:layout_marginTop="@dimen/safe_v"
        android:background="@drawable/frost_panel"
        android:padding="8dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/side"
        android:layout_width="340dp"
        android:layout_height="match_parent"
        android:layout_gravity="right"
        android:layout_marginBottom="@dimen/safe_v"
        android:layout_marginRight="@dimen/safe_h"
        android:layout_marginTop="@dimen/safe_v"
        android:background="@drawable/frost_panel"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">
        <TextView android:id="@+id/side_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:padding="10dp" android:textColor="@color/text" android:textSize="@dimen/type_title" android:fontFamily="@string/font_strong" />
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/side_list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    </LinearLayout>
</FrameLayout>
