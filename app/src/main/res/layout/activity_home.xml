<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <!-- Page: Home / Movies / TV shows (hero + rows) -->
    <LinearLayout
        android:id="@+id/page_rows"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/hero_area"
            android:layout_width="match_parent"
            android:layout_height="236dp">

            <ImageView android:id="@+id/hero_a" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" />
            <ImageView android:id="@+id/hero_b" android:layout_width="match_parent" android:layout_height="match_parent" android:alpha="0" android:scaleType="centerCrop" />
            <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/scrim_left" />
            <View android:layout_width="match_parent" android:layout_height="90dp" android:layout_gravity="bottom" android:background="@drawable/scrim_bottom" />

            <LinearLayout
                android:layout_width="480dp"
                android:layout_height="match_parent"
                android:gravity="bottom"
                android:orientation="vertical"
                android:paddingBottom="10dp"
                android:paddingLeft="@dimen/content_start">

                <TextView android:id="@+id/hero_title" android:shadowColor="#CC000000" android:shadowRadius="8" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:fontFamily="@string/font_strong" android:maxLines="2" android:textColor="@color/text" android:textSize="@dimen/type_headline" />
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:orientation="horizontal">
                    <TextView android:id="@+id/hero_c1" style="@style/Chip" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <TextView android:id="@+id/hero_c2" style="@style/Chip" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <TextView android:id="@+id/hero_c3" style="@style/Chip" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                </LinearLayout>
                <TextView android:id="@+id/hero_desc" android:shadowColor="#CC000000" android:shadowRadius="6" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:ellipsize="end" android:maxLines="3" android:textColor="@color/text" android:textSize="@dimen/type_caption" />
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:orientation="horizontal">
                    <TextView android:id="@+id/hero_play" style="@style/BtnPrimary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginRight="8dp" android:drawableLeft="@drawable/ic_play" android:paddingBottom="5dp" android:paddingTop="5dp" android:text="Play" />
                    <TextView android:id="@+id/hero_more" style="@style/Btn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:drawableLeft="@drawable/ic_info" android:paddingBottom="5dp" android:paddingTop="5dp" android:text="More Info" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rows"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipChildren="true"
            android:clipToPadding="true" />
    </LinearLayout>

    <!-- Page: Live (category sidebar + channel tiles) -->
    <LinearLayout
        android:id="@+id/page_live"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:paddingTop="64dp"
        android:visibility="gone">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/live_cats"
            android:layout_width="250dp"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="20dp"
            android:paddingLeft="@dimen/content_start"
            android:paddingRight="12dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/live_grid"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingBottom="20dp"
            android:paddingLeft="12dp"
            android:paddingRight="@dimen/safe_h"
            android:paddingTop="8dp" />
    </LinearLayout>

    <!-- Page: EPG -->
    <LinearLayout
        android:id="@+id/page_epg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingTop="64dp"
        android:visibility="gone">

        <FrameLayout android:id="@+id/epg_head" android:layout_width="match_parent" android:layout_height="26dp" />
        <TextView
            android:id="@+id/epg_msg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="40dp"
            android:textColor="@color/text_dim"
            android:textSize="@dimen/type_body"
            android:visibility="gone" />
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/epg_rows"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipChildren="false" />
    </LinearLayout>

    <!-- Left icon rail: Search, Favorites, Settings -->
    <LinearLayout
        android:id="@+id/rail"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="left"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingLeft="16dp"
        android:paddingRight="8dp">
        <ImageView android:id="@+id/rail_search" style="@style/Rail" android:src="@drawable/ic_search" />
        <ImageView android:id="@+id/rail_fav" style="@style/Rail" android:src="@drawable/ic_fav" />
        <ImageView android:id="@+id/nav_settings" style="@style/Rail" android:src="@drawable/ic_settings" />
    </LinearLayout>

    <!-- Slim top menu (tab 0 is a hidden placeholder; Search lives in the rail) -->
    <LinearLayout
        android:id="@+id/tabs"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="top"
        android:orientation="horizontal"
        android:paddingLeft="@dimen/content_start"
        android:paddingRight="@dimen/safe_h"
        android:paddingTop="@dimen/safe_v">

        <TextView style="@style/Tab" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Search" android:visibility="gone" />
        <TextView style="@style/Tab" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginRight="4dp" android:text="Home" />
        <TextView style="@style/Tab" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginRight="4dp" android:text="Live" />
        <TextView style="@style/Tab" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginRight="4dp" android:text="EPG" />
        <TextView style="@style/Tab" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginRight="4dp" android:text="Movies" />
        <TextView style="@style/Tab" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TV shows" />

        <TextView
            android:id="@+id/status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginLeft="12dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="right"
            android:maxLines="1"
            android:shadowColor="#000000"
            android:shadowRadius="4"
            android:textColor="@color/text"
            android:textSize="@dimen/type_micro" />
    </LinearLayout>

    <!-- Category drawer (Left on the first card of Movies / TV shows) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/drawer"
        android:layout_width="260dp"
        android:layout_height="match_parent"
        android:layout_marginBottom="@dimen/safe_v"
        android:layout_marginLeft="@dimen/content_start"
        android:layout_marginTop="64dp"
        android:background="@drawable/frost_panel"
        android:padding="8dp"
        android:visibility="gone" />
</FrameLayout>
