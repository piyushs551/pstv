<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <ImageView android:id="@+id/backdrop" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" />
    <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/scrim_left" />
    <View android:layout_width="match_parent" android:layout_height="260dp" android:layout_gravity="bottom" android:background="@drawable/scrim_bottom" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingBottom="@dimen/safe_v"
        android:paddingLeft="@dimen/content_start"
        android:paddingRight="@dimen/safe_h"
        android:paddingTop="@dimen/safe_v">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="bottom"
            android:orientation="vertical">

            <TextView android:id="@+id/d_title" android:layout_width="520dp" android:layout_height="wrap_content" android:ellipsize="end" android:fontFamily="@string/font_strong" android:maxLines="2" android:textColor="@color/text" android:textSize="@dimen/type_display" />
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="horizontal">
                <TextView android:id="@+id/d_c1" style="@style/Chip" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/d_c2" style="@style/Chip" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/d_c3" style="@style/Chip" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>
            <TextView android:id="@+id/d_desc" android:layout_width="520dp" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:ellipsize="end" android:maxLines="4" android:textColor="@color/text" android:textSize="@dimen/type_caption" />
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal">
                <TextView android:id="@+id/d_play" style="@style/BtnPrimary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginRight="8dp" android:drawableLeft="@drawable/ic_play" android:text="Play" />
                <TextView android:id="@+id/d_fav" style="@style/Btn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:drawableLeft="@drawable/ic_fav" android:text="Add to Favorites" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/series_area"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView android:id="@+id/season_btn" style="@style/Btn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:drawablePadding="10dp" android:drawableRight="@drawable/ic_expand" android:text="Season 1" />
            <TextView android:id="@+id/ep_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:ellipsize="end" android:fontFamily="@string/font_strong" android:maxLines="1" android:textColor="@color/text" android:textSize="@dimen/type_title" />
            <TextView android:id="@+id/ep_desc" android:layout_width="520dp" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:ellipsize="end" android:maxLines="2" android:textColor="@color/text_dim" android:textSize="@dimen/type_caption" />
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/ep_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingBottom="2dp"
                android:paddingTop="12dp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
