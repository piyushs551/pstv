<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <ImageView android:id="@+id/backdrop" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" />
    <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/scrim_left" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:paddingBottom="@dimen/safe_v"
        android:paddingLeft="@dimen/safe_h"
        android:paddingRight="@dimen/safe_h"
        android:paddingTop="@dimen/safe_v">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView android:id="@+id/d_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text" android:textSize="@dimen/type_display" android:fontFamily="@string/font_strong" />
            <TextView android:id="@+id/d_meta" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/text_dim" android:textSize="@dimen/type_body" />
            <TextView android:id="@+id/d_desc" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:ellipsize="end" android:maxLines="7" android:textColor="@color/text" android:textSize="@dimen/type_body" />

            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:orientation="horizontal">
                <TextView android:id="@+id/d_play" style="@style/BtnPrimary" android:drawableLeft="@drawable/ic_play" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginRight="10dp" android:text="Play" />
                <TextView android:id="@+id/d_fav" style="@style/Btn" android:drawableLeft="@drawable/ic_fav" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Add to Favorites" />
            </LinearLayout>
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/episodes"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="24dp"
            android:layout_weight="1"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
